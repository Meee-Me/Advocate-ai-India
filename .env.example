# ---------- Where this site lives (required) ----------
# The exact public address, no trailing slash. Sign-in emails link back to <APP_URL>/api/auth/confirm,
# so the same address must be set as the Site URL / a Redirect URL in Supabase -> Authentication.
APP_URL=http://localhost:3000

# ---------- Database: Supabase Postgres ----------
# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler, port 6543).
DATABASE_URL=
# Your Supabase project address. Used for sign-in (Supabase Auth) and for the private PDF bucket.
SUPABASE_URL=
# Public anon/publishable key (Supabase > Project Settings > API). Used for sign-in; never the service-role key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-documents

# ---------- AI ----------
# "sambanova" (default), "ollama", "openrouter", "groq", "anthropic" or "mock". The only fallback is the optional backup below.
AI_PROVIDER=sambanova
# --- Ollama Cloud (AI_PROVIDER=ollama): OpenAI-compatible endpoint, no request pacing is counted by this site ---
# SECRET. Set it in Vercel (tick Sensitive), never in this file.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MAX_OUTPUT_TOKENS=12000
# --- SambaNova (AI_PROVIDER=sambanova) ---
# SECRET. Set it in Vercel (Settings -> Environment Variables, tick Sensitive), never in this file.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
# The plan's limits, shared by everyone on the site. These are the FREE tier; raise them on a paid plan (0 = off).
AI_LIMIT_RPM=20
AI_LIMIT_RPD=20
AI_LIMIT_TPD=200000
# Largest single request, in characters (about 40k tokens).
AI_MAX_INPUT_CHARS=150000
# Per-advocate requests per rolling 24 hours.
AI_DAILY_LIMIT=300
# "redact" (default, strict) removes unverified reporter citations; "tag" only marks them.
CITATION_MODE=redact
# OCR for scanned PDFs (runs on the server). Languages need an @tesseract.js-data/<code> package.
OCR_LANGUAGES=eng+hin
OCR_MAX_PAGES=60
# Only if AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Reminders ----------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=

# ---------- Local development only ----------
# AI_PROVIDER=mock                # canned AI answers, no API key needed
# DATABASE_DRIVER=pglite          # embedded Postgres in ./.local-data, no Supabase needed
# STORAGE_DRIVER=local            # PDFs saved in ./.local-data/files

# Optional backup: set AI_BACKUP_PROVIDER=groq (and GROQ_API_KEY, a secret) and Groq answers only when the main vendor
# cannot (key rejected, plan upgrade needed, limit reached, down, timed out). The consent box then names both vendors.
# GROQ_MODEL defaults to openai/gpt-oss-120b. Groq's free tier has small per-minute token limits, so long documents may be refused.
AI_BACKUP_PROVIDER=
GROQ_API_KEY=

# OpenRouter (AI_PROVIDER=openrouter): OPENROUTER_API_KEY is a secret. OPENROUTER_MODEL defaults to openai/gpt-oss-120b:free
# (free models have request limits and may log prompts: made-up data only).
OPENROUTER_API_KEY=
