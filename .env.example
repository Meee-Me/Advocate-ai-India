# ---------- Where this site lives (required) ----------
# The exact public address, no trailing slash. Deluxe Main only signs people in
# from addresses it has been told about (APP_ORIGINS on the Deluxe Main server).
APP_URL=http://localhost:3000
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# ---------- Sign-in: Deluxe Main ----------
# "deluxe" uses Deluxe Main. "dev" is a local-only stand-in and refuses to run in production.
AUTH_PROVIDER=deluxe
DELUXE_MAIN_URL=https://deluxe-main.vercel.app
DELUXE_APP_ID=advocate
# Endpoint paths on Deluxe Main (defaults match its current API; change if it changes).
DELUXE_CONNECT_PATH=/connect
DELUXE_EXCHANGE_PATH=/api/connect/exchange
DELUXE_ME_PATH=/api/auth/me
DELUXE_LOGOUT_PATH=/api/auth/logout

# ---------- Database: Supabase Postgres ----------
# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler, port 6543).
DATABASE_URL=
# Supabase Storage (private bucket) for uploaded PDFs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-documents

# ---------- Claude ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Set to "default" to let the API re-run a request on a fallback model if safety
# classifiers decline it (uses the beta endpoint). Leave empty to disable.
ANTHROPIC_REFUSAL_FALLBACK=
# Per-advocate AI requests per rolling 24 hours.
AI_DAILY_LIMIT=300

# ---------- Reminders ----------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=

# ---------- Local development only ----------
# AI_PROVIDER=mock                # canned AI answers, no API key needed
# DATABASE_DRIVER=pglite          # embedded Postgres in ./.local-data, no Supabase needed
# STORAGE_DRIVER=local            # PDFs saved in ./.local-data/files
